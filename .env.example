# Target agent: the model that writes SQL (majority of calls).
# Get a key at https://console.groq.com — keys look like gsk_...
# (Not xai-... — that is a different provider.)
GROQ_API_KEY=

# Analyzer + proposer (reflection). Get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Optional stronger reflection model if Gemini quality is not enough.
ANTHROPIC_API_KEY=
