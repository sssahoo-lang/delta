# Target agent: the model that writes SQL. Makes the vast majority of calls.
# Free tier at console.groq.com, no credit card.
# Binding limits: 6,000 tokens/min and 500,000 tokens/day (also 30 req/min, 14,400/day).
GROQ_API_KEY=

# Analyzer + proposer: the reflection models. Very few calls, but they need to
# be strong. Free tier at aistudio.google.com. 10 req/min, 1,500 req/day.
GEMINI_API_KEY=

# Optional. Only needed if free-tier reflection quality proves too weak.
# Never required; every command works without it.
ANTHROPIC_API_KEY=
